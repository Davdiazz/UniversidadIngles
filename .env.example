# Copia este archivo como .env y llena tus datos:   cp .env.example .env
# El archivo .env NO se sube a git (está en .gitignore).

# Tu dominio fijo gratuito de ngrok (dashboard.ngrok.com -> Domains). Ejemplo: tutor-ingles-david.ngrok-free.app
NGROK_DOMAIN=

# Webhook de PRODUCCIÓN de n8n (el workflow debe estar activo). Normalmente no hay que cambiarlo.
N8N_WEBHOOK=http://localhost:5678/webhook/tutor-ingles

# Cuántos mensajes por minuto puede mandar cada visitante (protege tu cuota gratis de Groq)
LIMITE_MENSAJES_POR_MINUTO=20

# Puerto del servidor del tutor
PUERTO=8080
